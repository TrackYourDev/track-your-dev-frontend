# ─────────────────────────────────────────────────────────────
# TrackYourDev — environment variables (TEMPLATE)
# Copy to .env.local (dev) or set these in your host / Vercel (prod).
# Do NOT put real secrets in this file — it is committed to git.
# ─────────────────────────────────────────────────────────────

# MongoDB (migrated backend)
MONGODB_URI=mongodb+srv://user:pass@cluster/db
MONGODB_DBNAME=trackyourdev

# GitHub App webhook (POST /api/webhook signature verification)
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# GitHub OAuth (used by /api/auth/github/callback and /api/auth/verify-github)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# Public client id exposed to the browser for the landing-page "Login" button's
# OAuth redirect. Must equal GITHUB_CLIENT_ID. Required at BUILD time (Next.js
# inlines NEXT_PUBLIC_* into the client bundle).
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_oauth_client_id

# GitHub App private key (RS256) used to mint installation tokens.
# Provide ONE of the following (PRIVATE_KEY takes precedence):
#   PRIVATE_KEY        -> the full PEM contents
#   PRIVATE_KEY_BASE64 -> the PEM, base64-encoded (handy for single-line env vars)
PRIVATE_KEY=
PRIVATE_KEY_BASE64=

# AI providers (Groq is used by the webhook/commits analysis; OpenAI is optional)
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key

# Waitlist email (nodemailer SMTP)
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=465
MAIL_USER=you@yourdomain.com
MAIL_PASS=your_smtp_password

# Cron protection for GET /api/cron/update-subscriptions (optional but recommended).
# If set, the endpoint requires: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── OAuth callback + session cookie scope ──────────────────────
# By default login returns to the current origin's /api/auth/github/callback
# (works on localhost and prod automatically). Optionally pin a fixed value
# (set BOTH to the same URL if you use them):
NEXT_PUBLIC_GITHUB_REDIRECT_URI=
GITHUB_REDIRECT_URI=
# Cross-subdomain session cookie domain in prod, e.g. ".trackyour.dev".
# Leave empty for localhost / single-domain (host-only cookie).
AUTH_COOKIE_DOMAIN=

# Optional: point the frontend API client at a different host.
# Leave EMPTY to call this app's own /api routes (recommended after the migration).
NEXT_PUBLIC_API_BASE_URL=
